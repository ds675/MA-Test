<div
  class='hero-timeline{% if section.settings.section_width == "full-width" %} hero-timeline--full-width{% endif %}'
  style='
    --hero-timeline-bg: {{ section.settings.background_color }};
    --hero-timeline-text: {{ section.settings.text_color }};
    --hero-timeline-dot: {{ section.settings.dot_color }};
    --hero-timeline-line: {{ section.settings.line_color }};
    --hero-timeline-padding-top: {{ section.settings.padding-block-start }}px;
    --hero-timeline-padding-bottom: {{ section.settings.padding-block-end }}px;
  '
>
  {% if section.settings.background_image %}
    <div class='hero-timeline__bg-image'>
      {{
        section.settings.background_image
        | image_url: width: section.settings.background_image.width
        | image_tag:
          sizes: '100vw',
          widths: '375,750,1100,1500,1780,2000',
          loading: 'lazy',
          class: 'hero-timeline__bg-img',
          alt: section.settings.background_image.alt
      }}
      <div class='hero-timeline__bg-overlay'></div>
    </div>
  {% endif %}

  <div class='hero-timeline__container{% if section.settings.section_width == "page-width" %} page-width{% endif %}'>
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class='hero-timeline__heading-area'>
        {% if section.settings.heading != blank %}
          <h2 class='hero-timeline__heading'>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class='hero-timeline__subheading'>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class='hero-timeline__timeline'>
        <div class='hero-timeline__line'></div>
        {% for block in section.blocks %}
          <div class='hero-timeline__item' {{ block.shopify_attributes }}>
            <div class='hero-timeline__dot-wrapper'>
              <div class='hero-timeline__dot'></div>
            </div>
            <div class='hero-timeline__item-content'>
              {% if block.settings.title != blank %}
                <h3 class='hero-timeline__item-title'>{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class='hero-timeline__item-description'>{{ block.settings.description | escape }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
.hero-timeline {
  position: relative;
  background-color: var(--hero-timeline-bg, #ffffff);
  color: var(--hero-timeline-text, #141414);
  padding-block-start: var(--hero-timeline-padding-top, 48px);
  padding-block-end: var(--hero-timeline-padding-bottom, 48px);
  overflow: hidden;
}

.hero-timeline__bg-image {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-timeline__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-timeline__bg-overlay {
  position: absolute;
  inset: 0;
  background-color: var(--hero-timeline-bg, #ffffff);
  opacity: 0.7;
}

.hero-timeline__container {
  position: relative;
  z-index: 1;
}

.hero-timeline__heading-area {
  margin-block-end: 40px;
}

.hero-timeline__heading {
  font-family: var(--font-heading--family);
  font-size: var(--font-size--2xl);
  line-height: var(--line-height--display-tight);
  margin: 0 0 8px;
  color: inherit;
}

.hero-timeline__subheading {
  font-family: var(--font-body--family);
  font-size: var(--font-size--md);
  line-height: var(--line-height--body-normal);
  margin: 0;
  opacity: 0.8;
  color: inherit;
}

.hero-timeline__timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding-inline-start: 24px;
}

.hero-timeline__line {
  position: absolute;
  top: 6px;
  bottom: 6px;
  inset-inline-start: 6px;
  width: 2px;
  background-color: var(--hero-timeline-line, #dddddd);
}

.hero-timeline__item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.hero-timeline__dot-wrapper {
  position: absolute;
  inset-inline-start: -24px;
  top: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
}

.hero-timeline__dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background-color: var(--hero-timeline-dot, #141414);
  flex-shrink: 0;
}

.hero-timeline__item-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hero-timeline__item-title {
  font-family: var(--font-heading--family);
  font-size: var(--font-size--base);
  font-weight: 700;
  line-height: var(--line-height--heading-normal);
  margin: 0;
  color: inherit;
}

.hero-timeline__item-description {
  font-family: var(--font-body--family);
  font-size: var(--font-size--sm);
  line-height: var(--line-height--body-normal);
  margin: 0;
  opacity: 0.8;
  color: inherit;
}

@media screen and (max-width: 768px) {
  .hero-timeline__heading {
    font-size: var(--font-size--xl);
  }

  .hero-timeline__heading-area {
    margin-block-end: 28px;
  }

  .hero-timeline__timeline {
    gap: 24px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero_timeline",
  "tag": "section",
  "class": "hero-timeline-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "t:settings.dot_color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "t:settings.line_color",
      "default": "#dddddd"
    },
    {
      "type": "header",
      "content": "t:content.background_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "timeline-item",
      "name": "t:names.steps",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.timeline_title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.timeline_description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_timeline",
      "blocks": [
        {
          "type": "timeline-item",
          "settings": {
            "title": "Step 1",
            "description": "Description for step one."
          }
        },
        {
          "type": "timeline-item",
          "settings": {
            "title": "Step 2",
            "description": "Description for step two."
          }
        },
        {
          "type": "timeline-item",
          "settings": {
            "title": "Step 3",
            "description": "Description for step three."
          }
        }
      ]
    }
  ]
}
{% endschema %}
